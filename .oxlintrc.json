{
  "$schema": "https://github.com/oxc-project/oxc/raw/refs/heads/main/npm/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "import",
    "jsx-a11y",
    "node",
    "oxc",
    "promise",
    "react",
    "react-perf",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "ignorePatterns": [
    "**/src/components/ui/**",
    "**/src/hooks/use-highlighted-code.ts",
    "**/src/hooks/use-mobile.ts",
    "**/src/lib/highlighter.tsx",
    "**/src/**/*.gen.ts"
  ]
}
